{
  "name": "General Extensions (0.9)",
  "private": true,
  "description": "Paperback extensions for websites with unique, non-generic themes. Maintained by Inkdex.",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "conformance": "npm run tsc && npm run lint:check && npm run format:check",
    "bundle": "paperback-cli bundle",
    "serve": "paperback-cli serve",
    "dev": "paperback-cli serve --watch",
    "logcat": "paperback-cli logcat",
    "test": "paperback-cli test --noConsole --output ./bundles/tests.json",
    "prepare": "husky",
    "test:check": "node scripts/check-tests.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:unit": "node --import ./scripts/ts-resolve.mjs --test \"test/unit/**/*.test.ts\"",
    "check": "node scripts/check-sources.mjs",
    "check:docs": "node scripts/sync-agent-docs.mjs --check",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "new-source": "node scripts/new-source.mjs"
  },
  "devDependencies": {
    "@paperback/toolchain": "^1.0.0-alpha.92",
    "@paperback/types": "^1.0.0-alpha.92",
    "@types/chai": "^5.2.3",
    "chai": "^6.3.0",
    "cheerio": "^1.2.0",
    "fastest-levenshtein": "^1.0.16",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "stemmer": "^2.0.1",
    "typescript": "^7.0.2"
  }
}
